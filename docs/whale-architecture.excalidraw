    {
      "id": "el-48",
      "type": "text",
      "x": 60,
      "y": 832,
      "width": 880,
      "height": 125.0,
      "angle": 0,
      "strokeColor": "#3F3F46",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
