      "seed": 620708569,
      "version": 1,
      "versionNonce": 63891758,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1   Finance signs the payout and seals it in an encrypted envelope\n2   It is posted on Monad: the order is fixed, the contents stay hidden\n3   The operator opens it and pays everyone, privately\n4   Only a receipt goes back to Monad, so results can be verified\n5   Employees withdraw real tokens from the vault, once, with a proof",
      "originalText": "1   Finance signs the payout and seals it in an encrypted envelope\n2   It is posted on Monad: the order is fixed, the contents stay hidden\n3   The operator opens it and pays everyone, privately\n4   Only a receipt goes back to Monad, so results can be verified\n5   Employees withdraw real tokens from the vault, once, with a proof",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
