# Operator-specific settings (no secrets). Secrets (OPERATOR_PK_*, RELAYER_PK_*, SYSTEM_RELAYER_PK,
# DEPLOYER_PRIVATE_KEY, ENC_PRIVATE_KEY) are read from ../.env (git-ignored) and never printed.
API_PORT=8787
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
# Private chain (anvil)
ANVIL_PORT=8777
DATA_DIR=./data
# 1 = expose GET /api/demo/accounts (testnet demo keys)
DEMO_MODE=1
# Bearer token for POST /api/demo/reset and /api/demo/mock-rate. Set it; if empty the endpoints are disabled.
DEMO_ADMIN_TOKEN=
# Use anvil Monad mode (anvil --network monad). 1 = on.
ANVIL_MONAD_MODE=1
# Relayer limits
RELAYER_MAX_INFLIGHT=12
# Optional fallback http RPC for Monad calls (comma separated); defaults to MONAD_TESTNET_RPC
MONAD_RPC_FALLBACKS=
# Fault injection for the restart test only: afterMine | afterSign
WHALE_CRASH_AT=

# Swap venue the MainBridge is set to: mock (MockSwap, simulated) or uniswap (UniswapV4Adapter, real v4 pool).
# Must match MainBridge.swapAdapter(); GET /api/status swap.matchesBridge reports it.
SWAP_VENUE=mock
