# Local operator or HTTPS ngrok base URL, without /api.
WHALE_API_URL=http://127.0.0.1:8787
# Optional override, including /api/events; otherwise derived from WHALE_API_URL.
# WHALE_WS_URL=wss://your-host.ngrok-free.app/api/events
# Exposes backend-provided TESTNET accounts to visitors. Enable only in a trusted environment.
WHALE_ENABLE_TEST_ACCOUNTS=0
